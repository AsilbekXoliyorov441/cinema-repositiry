// CineWave database schema.
//
// Conventions
// - Primary keys are UUIDs generated by the database layer (Prisma uuid()).
// - Money is always stored as integer minor units (e.g. cents, tiyin) together with an ISO-4217 currency.
// - Soft-deleted models carry `deletedAt`; repositories always filter `deletedAt: null` for public reads.
// - Historical/financial records (payments, audit logs, webhook events) never cascade on user deletion.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  BANNED
  DISABLED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AccessTier {
  FREE
  PRO
}

enum AgeRating {
  ALL
  AGE_6
  AGE_12
  AGE_16
  AGE_18
}

enum CrewJob {
  DIRECTOR
  WRITER
  PRODUCER
  COMPOSER
  CINEMATOGRAPHER
  EDITOR
  OTHER
}

enum MediaKind {
  POSTER
  BACKDROP
  PERSON_PHOTO
  SERIES_IMAGE
  EPISODE_STILL
  AVATAR
  COLLECTION_COVER
  OTHER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum StorageProvider {
  LOCAL
  S3
}

enum VideoProvider {
  EXTERNAL // licensed external file/manifest URL
  SIGNED_CDN // CDN supporting HMAC token-signed URLs
  YOUTUBE
  VIMEO
}

enum VideoAssetType {
  FEATURE
  TRAILER
  TEASER
  EXTRA
}

enum ManifestType {
  MP4
  HLS
  DASH
  EMBED
}

enum VideoAssetStatus {
  ACTIVE
  INACTIVE
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  SPOILER
  ABUSE
  HATE
  OFF_TOPIC
  OTHER
}

enum ModerationAction {
  HIDE
  UNHIDE
  DELETE
  REPORT_DISMISSED
  REPORT_RESOLVED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum PaymentProviderName {
  STRIPE
  CLICK
  PAYME
  MANUAL
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum NotificationType {
  SYSTEM
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  REVIEW_HIDDEN
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String?    @db.VarChar(255) // null for OAuth-only accounts
  displayName     String     @db.VarChar(80)
  birthDate       DateTime?  @db.Date
  avatarMediaId   String?    @db.Uuid
  status          UserStatus @default(ACTIVE)
  statusReason    String?    @db.VarChar(500)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  mfaSecretEnc    String?    @db.VarChar(255) // AES-256-GCM encrypted TOTP secret
  lastLoginAt     DateTime?
  isProtected     Boolean    @default(false) // bootstrap super admin cannot be banned/deleted by others
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  avatar              MediaAsset?           @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  roles               UserRole[]            @relation("UserRoles")
  rolesGranted        UserRole[]            @relation("UserRolesGrantedBy")
  sessions            Session[]
  oauthAccounts       OAuthAccount[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  watchlist           WatchlistItem[]
  progress            WatchProgress[]
  history             WatchHistory[]
  ratings             Rating[]
  reviews             Review[]
  reviewReports       ReviewReport[]        @relation("Reporter")
  resolvedReports     ReviewReport[]        @relation("Resolver")
  moderationLogs      ReviewModerationLog[]
  subscriptions       Subscription[]
  payments            Payment[]
  couponRedemptions   CouponRedemption[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  uploadedMedia       MediaAsset[]          @relation("MediaUploader")
  billingCustomers    BillingCustomer[]
  settingsUpdated     SiteSetting[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50) // SUPER_ADMIN, ADMIN, MODERATOR, USER, custom...
  description String?  @db.VarChar(255)
  level       Int // higher = more privileged; actors can only manage roles strictly below their own level
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100) // e.g. "content:write"
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRolesGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// A login session. Each refresh token belongs to one session (its rotation "family").
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  userAgent    String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(64)
  mfaVerified  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(100)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128) // HMAC-SHA256 of the opaque token
  expiresAt DateTime
  usedAt    DateTime? // set on rotation; reuse of a used token revokes the whole session
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @db.VarChar(255)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Email verification + email change confirmation tokens (single use, hashed).
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @db.VarChar(128)
  newEmail  String?      @db.VarChar(320)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Movie {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @db.VarChar(255)
  originalTitle     String?       @db.VarChar(255)
  slug              String        @unique @db.VarChar(280)
  overview          String?       @db.Text
  releaseDate       DateTime?     @db.Date
  releaseYear       Int? // denormalized from releaseDate for cheap filtering
  durationMinutes   Int?
  ageRating         AgeRating     @default(ALL)
  language          String?       @db.VarChar(10) // ISO 639-1
  originalLanguage  String?       @db.VarChar(10)
  country           String?       @db.VarChar(2) // ISO 3166-1 alpha-2
  status            ContentStatus @default(DRAFT)
  visibility        Visibility    @default(PUBLIC)
  accessTier        AccessTier    @default(FREE)
  featured          Boolean       @default(false)
  posterImageId     String?       @db.Uuid
  backdropImageId   String?       @db.Uuid
  trailerUrl        String?       @db.VarChar(2048)
  seoTitle          String?       @db.VarChar(255)
  seoDescription    String?       @db.VarChar(500)
  subtitleLanguages String[]      @default([])
  externalIds       Json? // { tmdb: "...", imdb: "..." }
  ratingCount       Int           @default(0)
  ratingSum         Int           @default(0)
  ratingAvg         Float         @default(0)
  viewCount         Int           @default(0)
  popularityScore   Float         @default(0)
  trendingScore     Float         @default(0)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  poster      MediaAsset?       @relation("MoviePoster", fields: [posterImageId], references: [id], onDelete: SetNull)
  backdrop    MediaAsset?       @relation("MovieBackdrop", fields: [backdropImageId], references: [id], onDelete: SetNull)
  genres      MovieGenre[]
  cast        MovieCast[]
  crew        MovieCrew[]
  collections CollectionMovie[]
  videos      VideoAsset[]
  subtitles   Subtitle[]
  watchlist   WatchlistItem[]
  progress    WatchProgress[]
  history     WatchHistory[]
  ratings     Rating[]
  reviews     Review[]

  @@index([status, visibility, deletedAt, publishedAt])
  @@index([releaseYear])
  @@index([country])
  @@index([language])
  @@index([ageRating])
  @@index([accessTier])
  @@index([featured])
  @@index([popularityScore])
  @@index([trendingScore])
  @@index([ratingAvg])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "movies_title_trgm_idx")
  @@map("movies")
}

model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movies MovieGenre[]
  series SeriesGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String @db.Uuid
  genreId String @db.Uuid

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([genreId])
  @@map("movie_genres")
}

model Person {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(220)
  biography    String?   @db.Text
  birthDate    DateTime? @db.Date
  deathDate    DateTime? @db.Date
  birthPlace   String?   @db.VarChar(200)
  photoMediaId String?   @db.Uuid
  externalIds  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  photo MediaAsset? @relation("PersonPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  cast  MovieCast[]
  crew  MovieCrew[]

  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "people_name_trgm_idx")
  @@map("people")
}

model MovieCast {
  id            String  @id @default(uuid()) @db.Uuid
  movieId       String  @db.Uuid
  personId      String  @db.Uuid
  characterName String? @db.VarChar(200)
  order         Int     @default(0)

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, characterName])
  @@index([personId])
  @@index([movieId, order])
  @@map("movie_cast")
}

model MovieCrew {
  id       String  @id @default(uuid()) @db.Uuid
  movieId  String  @db.Uuid
  personId String  @db.Uuid
  job      CrewJob
  jobTitle String? @db.VarChar(100)

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, job])
  @@index([personId])
  @@map("movie_crew")
}

model Series {
  id              String        @id @default(uuid()) @db.Uuid
  title           String        @db.VarChar(255)
  originalTitle   String?       @db.VarChar(255)
  slug            String        @unique @db.VarChar(280)
  overview        String?       @db.Text
  firstAirDate    DateTime?     @db.Date
  lastAirDate     DateTime?     @db.Date
  ageRating       AgeRating     @default(ALL)
  language        String?       @db.VarChar(10)
  country         String?       @db.VarChar(2)
  status          ContentStatus @default(DRAFT)
  visibility      Visibility    @default(PUBLIC)
  accessTier      AccessTier    @default(FREE)
  featured        Boolean       @default(false)
  posterImageId   String?       @db.Uuid
  backdropImageId String?       @db.Uuid
  trailerUrl      String?       @db.VarChar(2048)
  seoTitle        String?       @db.VarChar(255)
  seoDescription  String?       @db.VarChar(500)
  externalIds     Json?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  poster    MediaAsset?     @relation("SeriesPoster", fields: [posterImageId], references: [id], onDelete: SetNull)
  backdrop  MediaAsset?     @relation("SeriesBackdrop", fields: [backdropImageId], references: [id], onDelete: SetNull)
  genres    SeriesGenre[]
  seasons   Season[]
  watchlist WatchlistItem[]

  @@index([status, visibility, deletedAt, publishedAt])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "series_title_trgm_idx")
  @@map("series")
}

model SeriesGenre {
  seriesId String @db.Uuid
  genreId  String @db.Uuid

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@index([genreId])
  @@map("series_genres")
}

model Season {
  id            String        @id @default(uuid()) @db.Uuid
  seriesId      String        @db.Uuid
  seasonNumber  Int
  title         String?       @db.VarChar(255)
  overview      String?       @db.Text
  airDate       DateTime?     @db.Date
  posterImageId String?       @db.Uuid
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  series   Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  poster   MediaAsset? @relation("SeasonPoster", fields: [posterImageId], references: [id], onDelete: SetNull)
  episodes Episode[]

  @@unique([seriesId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id              String        @id @default(uuid()) @db.Uuid
  seasonId        String        @db.Uuid
  episodeNumber   Int
  title           String        @db.VarChar(255)
  overview        String?       @db.Text
  airDate         DateTime?     @db.Date
  durationMinutes Int?
  stillImageId    String?       @db.Uuid
  accessTier      AccessTier? // null = inherit from series
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  season    Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  still     MediaAsset?     @relation("EpisodeStill", fields: [stillImageId], references: [id], onDelete: SetNull)
  videos    VideoAsset[]
  subtitles Subtitle[]
  progress  WatchProgress[]
  history   WatchHistory[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model Collection {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(200)
  slug         String        @unique @db.VarChar(220)
  description  String?       @db.Text
  coverMediaId String?       @db.Uuid
  status       ContentStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  cover  MediaAsset?       @relation("CollectionCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  movies CollectionMovie[]

  @@index([status, sortOrder])
  @@map("collections")
}

model CollectionMovie {
  collectionId String @db.Uuid
  movieId      String @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([collectionId, movieId])
  @@index([movieId])
  @@map("collection_movies")
}

// ───────────────────────────── Media ─────────────────────────────

model MediaAsset {
  id              String          @id @default(uuid()) @db.Uuid
  kind            MediaKind       @default(OTHER)
  visibility      MediaVisibility @default(PUBLIC)
  storageProvider StorageProvider @default(LOCAL)
  storageKey      String          @unique @db.VarChar(512)
  originalName    String?         @db.VarChar(255) // sanitized, display only — never used as a path
  mimeType        String          @db.VarChar(100)
  sizeBytes       Int
  width           Int
  height          Int
  checksum        String          @db.VarChar(64) // sha256 of stored original
  variants        Json? // { thumb: { key, width, height, sizeBytes }, ... }
  altText         String?         @db.VarChar(300)
  uploadedById    String?         @db.Uuid
  orphanedAt      DateTime? // set by the orphan cleanup job when no references exist
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  uploadedBy       User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  moviePosters     Movie[]      @relation("MoviePoster")
  movieBackdrops   Movie[]      @relation("MovieBackdrop")
  seriesPosters    Series[]     @relation("SeriesPoster")
  seriesBackdrops  Series[]     @relation("SeriesBackdrop")
  seasonPosters    Season[]     @relation("SeasonPoster")
  episodeStills    Episode[]    @relation("EpisodeStill")
  personPhotos     Person[]     @relation("PersonPhoto")
  userAvatars      User[]       @relation("UserAvatar")
  collectionCovers Collection[] @relation("CollectionCover")

  @@index([kind])
  @@index([checksum])
  @@index([uploadedById])
  @@index([orphanedAt])
  @@index([createdAt])
  @@map("media_assets")
}

model VideoAsset {
  id              String           @id @default(uuid()) @db.Uuid
  movieId         String?          @db.Uuid
  episodeId       String?          @db.Uuid
  provider        VideoProvider
  assetType       VideoAssetType   @default(FEATURE)
  playbackUrl     String           @db.VarChar(2048)
  manifestType    ManifestType
  qualityLabel    String?          @db.VarChar(20) // e.g. "1080p", "4K"
  language        String?          @db.VarChar(10)
  isDefault       Boolean          @default(false)
  requiresSigning Boolean          @default(false)
  premiumOnly     Boolean          @default(false) // e.g. 4K variant restricted to plans with HD_QUALITY
  status          VideoAssetStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  lastCheckStatus Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([movieId, status])
  @@index([episodeId, status])
  @@map("video_assets")
}

model Subtitle {
  id        String   @id @default(uuid()) @db.Uuid
  movieId   String?  @db.Uuid
  episodeId String?  @db.Uuid
  language  String   @db.VarChar(10)
  label     String   @db.VarChar(80)
  url       String   @db.VarChar(2048) // WebVTT URL
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([episodeId])
  @@map("subtitles")
}

// ─────────────────────────── User activity ───────────────────────────

model WatchlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  movieId   String?  @db.Uuid
  seriesId  String?  @db.Uuid
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
  @@index([userId, createdAt])
  @@map("watchlist_items")
}

/// Current playback state per user and content item (one row each).
model WatchProgress {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  movieId         String?   @db.Uuid
  episodeId       String?   @db.Uuid
  positionSeconds Int       @default(0)
  durationSeconds Int
  completed       Boolean   @default(false)
  completedAt     DateTime?
  lastWatchedAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, episodeId])
  @@index([userId, completed, lastWatchedAt])
  @@map("watch_progress")
}

/// One row per user, content item and calendar day on which playback started (analytics + history list).
model WatchHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  movieId       String?  @db.Uuid
  episodeId     String?  @db.Uuid
  watchedOn     DateTime @db.Date
  startedAt     DateTime @default(now())
  lastWatchedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, watchedOn])
  @@unique([userId, episodeId, watchedOn])
  @@index([userId, lastWatchedAt])
  @@index([movieId, watchedOn])
  @@map("watch_history")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  movieId   String   @db.Uuid
  score     Int // 1..10, enforced by validation and a CHECK constraint in the migration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  movieId          String       @db.Uuid
  title            String?      @db.VarChar(150)
  body             String       @db.Text
  containsSpoilers Boolean      @default(false)
  status           ReviewStatus @default(VISIBLE)
  reportCount      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie          Movie                 @relation(fields: [movieId], references: [id], onDelete: Cascade)
  reports        ReviewReport[]
  moderationLogs ReviewModerationLog[]

  @@unique([userId, movieId])
  @@index([movieId, status, deletedAt, createdAt])
  @@index([status])
  @@map("reviews")
}

model ReviewReport {
  id           String       @id @default(uuid()) @db.Uuid
  reviewId     String       @db.Uuid
  reporterId   String       @db.Uuid
  reason       ReportReason
  details      String?      @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@map("review_reports")
}

model ReviewModerationLog {
  id          String           @id @default(uuid()) @db.Uuid
  reviewId    String           @db.Uuid
  moderatorId String?          @db.Uuid
  action      ModerationAction
  reason      String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderator User?  @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@map("review_moderation_logs")
}

// ───────────────────────── Billing ─────────────────────────

model SubscriptionPlan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  slug            String          @unique @db.VarChar(100)
  description     String?         @db.VarChar(1000)
  priceMinor      Int // integer minor units; 0 = free plan (not purchasable)
  currency        String          @db.VarChar(3) // ISO 4217, upper case
  billingInterval BillingInterval
  intervalCount   Int             @default(1)
  trialDays       Int             @default(0)
  features        String[]        @default([]) // feature flags, e.g. PRO_CONTENT, HD_QUALITY
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions  Subscription[]
  providerPrices PlanProviderPrice[]
  coupons        CouponPlan[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

/// Provider-side price objects (e.g. Stripe Price IDs). Prices are immutable at providers,
/// so a new row is created whenever plan price/interval changes.
model PlanProviderPrice {
  id              String              @id @default(uuid()) @db.Uuid
  planId          String              @db.Uuid
  provider        PaymentProviderName
  priceMinor      Int
  currency        String              @db.VarChar(3)
  billingInterval BillingInterval
  intervalCount   Int
  livemode        Boolean
  providerPriceId String              @db.VarChar(255)
  createdAt       DateTime            @default(now())

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, provider, priceMinor, currency, billingInterval, intervalCount, livemode])
  @@unique([provider, providerPriceId])
  @@map("plan_provider_prices")
}

model BillingCustomer {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  provider           PaymentProviderName
  livemode           Boolean
  providerCustomerId String              @db.VarChar(255)
  createdAt          DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, provider, livemode])
  @@unique([provider, providerCustomerId])
  @@map("billing_customers")
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @db.Uuid
  planId                 String              @db.Uuid
  status                 SubscriptionStatus  @default(PENDING)
  startsAt               DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  expiryReminderSentAt   DateTime?
  provider               PaymentProviderName
  providerSubscriptionId String?             @unique @db.VarChar(255)
  providerCheckoutId     String?             @unique @db.VarChar(255)
  livemode               Boolean             @default(false)
  statusReason           String?             @db.VarChar(500)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  coupons  CouponRedemption[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  subscriptionId    String?             @db.Uuid
  provider          PaymentProviderName
  providerPaymentId String?             @unique @db.VarChar(255) // e.g. Stripe invoice id
  providerChargeRef String?             @db.VarChar(255) // e.g. Stripe payment_intent id, used for refunds
  idempotencyKey    String              @unique @db.VarChar(255)
  amountMinor       Int
  refundedMinor     Int                 @default(0)
  discountMinor     Int                 @default(0)
  currency          String              @db.VarChar(3)
  status            PaymentStatus       @default(PENDING)
  livemode          Boolean             @default(false)
  paymentMethod     String?             @db.VarChar(50)
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  failureCode       String?             @db.VarChar(100)
  metadata          Json? // non-sensitive only: plan slug, period, coupon code
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  redemption   CouponRedemption?

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([providerChargeRef])
  @@map("payments")
}

/// Every verified webhook event is stored once (unique provider+eventId) — the idempotency guard.
model PaymentWebhookEvent {
  id          String              @id @default(uuid()) @db.Uuid
  provider    PaymentProviderName
  eventId     String              @db.VarChar(255)
  eventType   String              @db.VarChar(100)
  livemode    Boolean
  status      WebhookEventStatus  @default(RECEIVED)
  attempts    Int                 @default(0)
  error       String?             @db.VarChar(1000)
  processedAt DateTime?
  createdAt   DateTime            @default(now())

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("payment_webhook_events")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(50) // stored upper-case
  description    String?      @db.VarChar(255)
  discountType   DiscountType
  percentOff     Int? // 1..100 when PERCENT
  amountOffMinor Int? // when FIXED
  currency       String?      @db.VarChar(3) // required when FIXED
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int? // global limit
  perUserLimit   Int          @default(1)
  minAmountMinor Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plans       CouponPlan[]
  redemptions CouponRedemption[]

  @@index([isActive])
  @@map("coupons")
}

/// If a coupon has no rows here it applies to every plan.
model CouponPlan {
  couponId String @db.Uuid
  planId   String @db.Uuid

  coupon Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@map("coupon_plans")
}

model CouponRedemption {
  id             String                 @id @default(uuid()) @db.Uuid
  couponId       String                 @db.Uuid
  userId         String                 @db.Uuid
  subscriptionId String?                @db.Uuid
  paymentId      String?                @unique @db.Uuid
  status         CouponRedemptionStatus @default(RESERVED)
  discountMinor  Int
  currency       String                 @db.VarChar(3)
  expiresAt      DateTime // reservation expiry
  redeemedAt     DateTime?
  createdAt      DateTime               @default(now())

  coupon       Coupon        @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([couponId, status])
  @@index([couponId, userId, status])
  @@index([status, expiresAt])
  @@map("coupon_redemptions")
}

// ───────────────────────── Platform ─────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.VarChar(2000)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  actorId    String?       @db.Uuid
  action     String        @db.VarChar(100) // e.g. "movie.update", "user.ban"
  entityType String?       @db.VarChar(50)
  entityId   String?       @db.VarChar(100)
  severity   AuditSeverity @default(LOW)
  metadata   Json?
  ipAddress  String?       @db.VarChar(64)
  userAgent  String?       @db.VarChar(500)
  createdAt  DateTime      @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}
