# Production environment template. Copy to .env.production, fill every empty secret.
# The app refuses to start when production rules are violated (see src/config/env.ts).
# ─── Runtime ───
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
# Number of reverse proxies in front of the app (nginx/traefik = 1). Needed for correct client IPs.
TRUST_PROXY=1
LOG_LEVEL=info

# ─── Infrastructure ───
# DATABASE_URL / REDIS_URL are set by docker-compose.yml from POSTGRES_* below.
# Set them here only when using an external/managed database or Redis.
# DATABASE_URL=postgresql://cinewave:STRONG_PASSWORD@postgres:5432/cinewave?schema=public
# REDIS_URL=redis://redis:6379/0
POSTGRES_USER=cinewave
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=cinewave

# ─── URLs / CORS ───
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com
ADMIN_URL=https://admin.example.com
# Extra comma-separated origins allowed to call the API
CORS_ORIGINS=

# ─── Auth (generate with: openssl rand -hex 48) ───
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=cinewave-api
JWT_AUDIENCE=cinewave-clients
# 32 bytes hex (openssl rand -hex 32) — encrypts TOTP secrets at rest
MFA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=false

# ─── Cookies ───
# Parent domain shared by the API and frontend, e.g. .example.com
COOKIE_DOMAIN=.example.com
# Must be true in production (HTTPS). Set false only for plain-http local development.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ─── Storage ───
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage/uploads
# Public base URL for media files, e.g. https://cdn.example.com/media. Defaults to APP_URL/media
PUBLIC_MEDIA_BASE_URL=
MAX_IMAGE_SIZE_MB=10
MAX_BULK_UPLOAD_FILES=10
ORPHAN_MEDIA_GRACE_HOURS=72
ORPHAN_MEDIA_AUTO_DELETE=false

# ─── Email ───
# file = writes .html emails to EMAIL_FILE_DIR (development only); smtp = real delivery
EMAIL_PROVIDER=smtp
EMAIL_FROM=CineWave <no-reply@example.com>
EMAIL_FILE_DIR=./storage/dev-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ─── Payments ───
# stripe | none (none disables checkout; the rest of the API keeps working)
PAYMENT_PROVIDER=none
# test | live — live mode refuses sk_test_ keys and vice versa
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_PATH=/subscription/success
CHECKOUT_CANCEL_PATH=/subscription/cancel
CHECKOUT_RESERVATION_MINUTES=60
# Reserved for future adapters (see docs/payments-integration.md); not used yet.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ─── Google OAuth (optional — set all three or none) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Playback ───
# HMAC secret shared with a CDN supporting token auth (nginx secure_link, BunnyCDN, ...)
PLAYBACK_SIGNING_SECRET=
PLAYBACK_URL_TTL_SECONDS=3600
# Optional allowlist of hosts for video URLs (comma separated). Empty = any public https host.
VIDEO_ALLOWED_HOSTS=
EMBED_ALLOWED_HOSTS=www.youtube.com,youtube.com,www.youtube-nocookie.com,player.vimeo.com

# ─── Swagger ───
SWAGGER_ENABLED=false
# Required in production when SWAGGER_ENABLED=false (HTTP basic auth)
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─── Rate limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15MIN=20

# ─── Jobs ───
# true = run BullMQ workers inside the API process (small deployments). Default: separate worker service.
RUN_WORKERS_IN_API=false

# ─── First super admin (used once by `npm run bootstrap:admin`, then remove) ───
# Do NOT keep these here; pass them once on the command line (see DEPLOY.md).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
