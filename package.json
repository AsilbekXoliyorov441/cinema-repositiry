{
  "name": "cinewave-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CineWave — production-ready REST API for a movie streaming platform",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bootstrap:admin": "tsx --env-file-if-exists=.env src/cli/bootstrap-admin.ts",
    "bootstrap:admin:prod": "node --env-file-if-exists=.env dist/cli/bootstrap-admin.js",
    "openapi:export": "tsx --env-file-if-exists=.env src/cli/export-openapi.ts",
    "db:seed:prod": "node --env-file-if-exists=.env dist/cli/seed.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:setup-db": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.63.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jose": "6.1.0",
    "multer": "2.0.2",
    "nodemailer": "7.0.10",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "rate-limit-redis": "4.2.3",
    "sharp": "0.34.5",
    "stripe": "18.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.3",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "pino-pretty": "13.1.2",
    "prettier": "3.6.2",
    "rimraf": "6.1.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "msgpackr-extract": false
  }
}
